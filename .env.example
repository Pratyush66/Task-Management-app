# ==============================================================================
# Task Management App - Environment Configuration Template
# ==============================================================================
# Copy this file to:
#   1. backend/.env (for Flask API)
#   2. frontend/.env.local (for Next.js frontend)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. SUPABASE CONFIGURATION (Database & Auth)
# ------------------------------------------------------------------------------
# Obtain these from your Supabase Project Settings -> API
SUPABASE_URL=https://your-project-id.supabase.co
SUPABASE_ANON_KEY=your-supabase-anon-public-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWT_SECRET=your-supabase-jwt-secret

# ------------------------------------------------------------------------------
# 2. BACKEND (FLASK) CONFIGURATION
# ------------------------------------------------------------------------------
FLASK_ENV=development
FLASK_DEBUG=1
FLASK_RUN_PORT=5000
FRONTEND_URL=http://localhost:3000

# ------------------------------------------------------------------------------
# 3. GMAIL SMTP CONFIGURATION (For Automated Notifications)
# ------------------------------------------------------------------------------
# Step 1: Enable 2-Step Verification on your Google/Gmail account
# Step 2: Go to Google Account -> Security -> App passwords
# Step 3: Generate an App Password for 'Mail' / 'TaskFlow'
# Note: In development, if left blank, emails are logged to the console
GMAIL_USER=your-email@gmail.com
GMAIL_APP_PASSWORD=your-16-character-app-password
MAIL_FROM_NAME=TaskFlow Notification

# ------------------------------------------------------------------------------
# 4. FRONTEND (NEXT.JS) PUBLIC CONFIGURATION
# ------------------------------------------------------------------------------
# Must be prefixed with NEXT_PUBLIC_ for client-side bundle access
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-public-key
NEXT_PUBLIC_API_URL=http://localhost:5000/api
NEXT_PUBLIC_APP_URL=http://localhost:3000
